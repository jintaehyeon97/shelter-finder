# PostgreSQL 접속 정보
# 로컬 설치 시 예시: postgresql://postgres:비밀번호@localhost:5432/conbini
# Supabase/Neon 등 클라우드 사용 시: 해당 서비스에서 제공하는 Connection String 그대로 사용
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conbini

PORT=4000

# 공공데이터포털 (data.go.kr) 에서 발급받은 인증키
PUBLIC_DATA_API_KEY=여기에_발급받은_키_입력

# 전국도시공원 API가 별도 인증키를 요구하는 경우에만 사용 (같으면 비워둬도 됨)
PUBLIC_DATA_API_KEY_PARK=

# TMAP(SK Open API)에서 발급받은 App Key (보행자 경로 안내용)
TMAP_APP_KEY=여기에_발급받은_TMAP_App_Key_입력

# TMAP 대중교통 API 전용 App Key (도보경로와 별도 상품/키)
TMAP_TRANSIT_APP_KEY=여기에_발급받은_TMAP_대중교통_App_Key_입력

# 카카오 개발자센터에서 발급받은 REST API 키 (편의점 실존 여부 대조 검증용)
KAKAO_REST_API_KEY=여기에_발급받은_카카오_REST_API_키_입력
