{
  "name": "conbini-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "migrate": "ts-node-dev --transpile-only src/scripts/migrate.ts",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "seed:api": "ts-node-dev --transpile-only src/scripts/seedFromApi.ts",
    "seed:heat-shelters": "ts-node-dev --transpile-only src/scripts/seedHeatShelters.ts",
    "seed:parks": "ts-node-dev --transpile-only src/scripts/seedParks.ts",
    "verify:stores": "ts-node-dev --transpile-only src/scripts/verifyStoresWithKakao.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "proj4": "^2.11.0",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/cors": "^2.8.17"
  }
}
